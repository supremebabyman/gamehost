These are used to restore to previous versions/ commits
git checkout <commit-hash> . //change <commit-hash> to the hash of the commit you want to restore and the . is supposed to be there
if the last one didn't work then use git reset --hard <commit-hash> .
git commit -m "Roll back project state to commit <commit-hash>" //same with this one

git checkout dd0ab017018c05bb0110ddeaa7e26cb5807f4812 .
git commit -m "Roll back project state to commit dd0ab017018c05bb0110ddeaa7e26cb5807f4812"


git reset --hard <dd0ab017018c05bb0110ddeaa7e26cb5807f4812> .
git commit -m "Roll back project state to commit <dd0ab017018c05bb0110ddeaa7e26cb5807f4812>"
